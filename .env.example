# Copy to .env.local and fill in values (see docs/env-vars.md)

NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LEADFLOW_HMAC_SECRET=

# Lead capture UI: "scripted" (default) | "ai" (uses /api/capture/chat; needs ANTHROPIC_API_KEY)
NEXT_PUBLIC_CHAT_MODE=scripted
# Optional server override (same values); wins over NEXT_PUBLIC_CHAT_MODE when non-empty
# CAPTURE_CHAT_MODE=
# ANTHROPIC_API_KEY=

# Optional
# Python ingest feeders (see python/README.md), e.g. mb_roll_entry/ingest_mb_roll_entry.py --send
LEADFLOW_API_URL=http://localhost:3000/api/ingest
LEADFLOW_WEBHOOK_URL=
LEADFLOW_DRY_RUN=
LEADFLOW_COMPLIANCE_FOOTER=
SENTRY_DSN=
